# ===== LINE Messaging API =====
# Get these from LINE Developers Console → Messaging API channel
# https://developers.line.biz/console/
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE OA basic ID (for reference / display only, not used in API calls)
LINE_OA_BASIC_ID=@799iqrzy

# LINE Group ID for admin notifications (lead alerts)
# How to get: invite bot to group → bot receives event with groupId → log it once
LINE_ADMIN_GROUP_ID=

# ===== Anthropic (Claude API) =====
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024

# ===== Supabase =====
# Get from Supabase project → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ===== Email (Resend) =====
# Get from https://resend.com/api-keys
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=admin@zenityxai.com
LEAD_FROM_EMAIL=noreply@zenityxai.com

# ===== App =====
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
